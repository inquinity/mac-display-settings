<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Finder Sync extensions must be sandboxed. No other access is needed:
	     the extension only builds a menu and opens a System Settings URL. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
